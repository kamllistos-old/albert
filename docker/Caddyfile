# The container holds no secret. The page trades a one-time code for the
# agent's token at POST /api/session and sends it as a Bearer header; Caddy
# only proxies /api, unchanged. Caddy keeps Host, Origin and Authorization as
# they arrived, and the agent does all the checks.
:80 {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}

	handle /api/* {
		reverse_proxy {$ALBERT_AGENT} {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		file_server
	}
}
